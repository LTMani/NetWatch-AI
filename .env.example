# ==============================================================================
# NETWATCH AI — ENTERPRISE NETWORK INTELLIGENCE PLATFORM
# Environment Configuration Template (Zero Credentials Policy)
# ==============================================================================
# Copy this file to .env and configure values for your local deployment.
# NEVER commit the actual .env file to version control.

# Application Core Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-random-secure-hex-string-in-production
JWT_SECRET_KEY=change-this-jwt-secret-to-a-secure-32-byte-hex-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_SECONDS=86400

# Database Configuration (SQLite default for local dev, PostgreSQL ready)
DATABASE_URL=sqlite:///instance/netwatch.db
# DATABASE_URL=postgresql://netwatch_user:netwatch_password@localhost:5432/netwatch_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=False

# Organization & Network Defaults
DEFAULT_ORGANIZATION_NAME=Apex Enterprise Global
DEFAULT_SITE_NAME=Headquarters Core
DEFAULT_OFFICE_START_TIME=09:00
DEFAULT_OFFICE_END_TIME=18:00
DEFAULT_WORK_DAYS=0,1,2,3,4
DEFAULT_TIMEZONE=UTC

# Network Telemetry & Streaming Engine
TELEMETRY_BUFFER_SIZE=5000
TELEMETRY_FLUSH_INTERVAL_SECONDS=5
MAX_TELEMETRY_BATCH_SIZE=1000
TELEMETRY_RETENTION_DAYS=90
PROBE_SHARED_SECRET=netwatch-probe-auth-token-placeholder

# Network Health & Diagnostic Weights
HEALTH_WEIGHT_LATENCY=0.25
HEALTH_WEIGHT_PACKET_LOSS=0.25
HEALTH_WEIGHT_JITTER=0.15
HEALTH_WEIGHT_BANDWIDTH_SATURATION=0.15
HEALTH_WEIGHT_ERROR_RATE=0.10
HEALTH_WEIGHT_LINK_FLAP=0.10

# Anomaly Detection & Baselining
ANOMALY_BASELINE_WINDOW_DAYS=30
ANOMALY_Z_SCORE_THRESHOLD=3.0
ANOMALY_EWMA_ALPHA=0.2
ANOMALY_ISOLATION_CONTAMINATION=0.03
ANOMALY_MIN_SAMPLE_COUNT=50

# Risk Posture & Scoring Engine
RISK_DECAY_HALF_LIFE_HOURS=72
RISK_SEVERITY_CRITICAL_WEIGHT=40
RISK_SEVERITY_HIGH_WEIGHT=25
RISK_SEVERITY_MEDIUM_WEIGHT=15
RISK_SEVERITY_LOW_WEIGHT=5

# AI Network Copilot (Optional External Provider Integration)
# NetWatch AI operates in full standalone deterministic mode by default.
# If an API key is provided, the copilot enhances synthesized grounding with the configured LLM.
AI_PROVIDER=deterministic
# AI_PROVIDER=gemini
# AI_PROVIDER=openai
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-1.5-pro
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048

# Security, Audit & Rate Limiting
RATE_LIMIT_DEFAULT=120 per minute
RATE_LIMIT_AUTH=15 per minute
RATE_LIMIT_TELEMETRY=1000 per minute
AUDIT_LOG_TAMPER_CHECK_ENABLED=True
PRIVACY_PAYLOAD_MASKING_ENABLED=True
MAX_CONTENT_LENGTH=16777216

# Notification & Alert Dispatcher
ALERT_NOTIFICATION_COOLDOWN_MINUTES=15
ALERT_EMAIL_ENABLED=False
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@netwatch.internal
